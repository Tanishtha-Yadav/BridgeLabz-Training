+-----------+
| Tanishtha |
| Suhani    |
| Raman     |
+-----------+
3 rows in set (0.00 sec)


mysql> UPDATE employee_data
    -> SET salary = 90000
    -> where name = 'Suhani'
    -> ;
Query OK, 1 row affected (0.01 sec)
Rows matched: 1  Changed: 1  Warnings: 0


mysql> SELECT * FROM employee_data;
+-----------+--------+------------+
| name      | salary | department |
+-----------+--------+------------+
| Tanishtha |  35000 | IT         |
| Suhani    |  90000 | Marketing  |
| Raman     | 150000 | IT         |
+-----------+--------+------------+
3 rows in set (0.00 sec)


